# Copy this file to .env.local (git-ignored) to use the Vite dev server with the
# deployed API: `npm run dev -w @gaceta/web` then forwards every /api request there.
#
# Use the API Gateway URL, without /api at the end. It is the `api_endpoint`
# output of infra/main (for example, https://abc123.execute-api.us-east-1.amazonaws.com).
VITE_DEV_API_PROXY_TARGET=
