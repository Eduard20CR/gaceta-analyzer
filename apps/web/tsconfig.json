{
  // The web app has two kinds of TypeScript files with different globals:
  // - tsconfig.app.json: the app in src/, which runs in the browser.
  // - tsconfig.node.json: vite.config.ts, which runs in Node.js.
  // This file only points at both, so editors and ESLint find the right one.
  "files": [],
  "references": [
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.node.json" }
  ]
}
