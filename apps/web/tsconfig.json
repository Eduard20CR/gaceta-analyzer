{
  // The web app has three kinds of TypeScript files with different globals:
  // - tsconfig.app.json: the app in src/, which runs in the browser.
  // - tsconfig.node.json: vite.config.ts and vitest.config.ts, which run in Node.js.
  // - tsconfig.test.json: the tests in tests/, which run in jsdom (a fake
  //   browser inside Node.js, ADR-0013).
  // This file only points at both, so editors and ESLint find the right one.
  "files": [],
  "references": [
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.node.json" },
    { "path": "./tsconfig.test.json" }
  ]
}
