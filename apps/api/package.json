{
  "name": "@gaceta/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "AWS Lambda handlers (authorizer, create-job, analyze-pdf, get-job, list-jobs).",
  "scripts": {
    "build": "node build.mjs && node scripts/check-bundles.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "analyze:local": "tsx scripts/analyze-local.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1162.0",
    "@aws-sdk/client-s3": "^3.1162.0",
    "@aws-sdk/client-ssm": "^3.1162.0",
    "@aws-sdk/lib-dynamodb": "^3.1162.0",
    "@aws-sdk/s3-presigned-post": "^3.1162.0",
    "@aws-sdk/s3-request-presigner": "^3.1162.0",
    "@gaceta/shared": "*",
    "openai": "^7.51.0",
    "unpdf": "^2.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^24.19.2",
    "aws-sdk-client-mock": "^4.1.0",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  }
}
